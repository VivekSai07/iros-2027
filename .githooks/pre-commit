#!/usr/bin/env bash
set -euo pipefail
branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ -z "$branch" ]]; then
    printf 'Commit refused: use a topic branch, not detached HEAD.\n' >&2
    exit 1
fi
if [[ "$branch" == main || "$branch" == master ]]; then
    if ! git rev-parse --quiet --verify MERGE_HEAD >/dev/null; then
        printf 'Commit refused: develop on a topic branch from main.\n' >&2
        exit 1
    fi
fi